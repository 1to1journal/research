<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | অ্যাডমিন · <%= siteName %></title>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <div class="admin-brand">One to One Journal<br /><small>অ্যাডমিন প্যানেল</small></div>
      <nav>
        <a href="/admin/dashboard" class="<%= tab === 'overview' ? 'active' : '' %>">ওভারভিউ</a>
        <a href="/admin/articles" class="<%= tab === 'articles' ? 'active' : '' %>">প্রবন্ধ</a>
        <a href="/admin/categories" class="<%= tab === 'categories' ? 'active' : '' %>">ক্যাটাগরি</a>
        <a href="/admin/readers" class="<%= tab === 'readers' ? 'active' : '' %>">নিবন্ধিত ইউজার</a>
        <a href="/admin/submissions" class="<%= tab === 'submissions' ? 'active' : '' %>">সাবমিশন</a>
        <a href="/admin/comments" class="<%= tab === 'comments' ? 'active' : '' %>">কমেন্ট</a>
        <a href="/admin/settings" class="<%= tab === 'settings' ? 'active' : '' %>">সেটিংস</a>
        <a href="/" target="_blank">সাইট দেখুন ↗</a>
        <form action="/admin/logout" method="post" class="logout-form">
          <button type="submit">লগআউট</button>
        </form>
      </nav>
    </aside>
    <main class="admin-content">
      <% if (typeof success !== 'undefined' && success.length) { %>
        <div class="flash flash-success"><%= success.join(', ') %></div>
      <% } %>
      <% if (typeof error !== 'undefined' && error.length) { %>
        <div class="flash flash-error"><%= error.join(', ') %></div>
      <% } %>
