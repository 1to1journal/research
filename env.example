# Copy this file to .env and fill in your own values before deploying.

# Port the server listens on (most free hosts set this automatically)
PORT=3000

# Session secret - use a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Set to "production" on your live host
NODE_ENV=development

# Used only once by `npm run seed` to create the first admin account.
# After that, change the password from Admin Dashboard > Settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# --- Email notifications (optional but recommended) ---
# Used to notify onetoonejournal@gmail.com when someone submits an article/
# conference paper/book, and to notify researchers when admin updates their
# submission's progress. If left blank, the app still works - submissions
# and progress are always tracked in the software either way, emails are
# just a convenience on top.
#
# Easiest option: use a Gmail "App Password" (Google Account > Security >
# 2-Step Verification > App passwords). Do NOT use your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=onetoonejournal@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=onetoonejournal@gmail.com
SUBMISSION_NOTIFY_EMAIL=onetoonejournal@gmail.com
